# YGU Rehberi (statik Nuxt çıktısı, Apache/cPanel).
# Amaç: her sayfanın tek adresi olsun — https://ygurehberi.com/yol (www yok, http yok, sonda / yok).
# sitemap.xml ve canonical etiketleri bu biçimi kullanır; Search Console "yönlendirmeli sayfa" uyarısı vermesin.

Options -Indexes
DirectorySlash Off
ErrorDocument 404 /404.html

RewriteEngine On

# www → çıplak alan adı
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# http → https
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Taşınan sayfalar (18 Ekim 2026: YGU Hakkında altına) → kalıcı yönlendirme
RewriteRule ^yangin-guvenlik-uzmani-nedir/?$ /ygu-hakkinda/mevzuat/yangin-guvenlik-uzmani-nedir [R=301,L]
RewriteRule ^yangin-guvenlik-uzmani-nasil-olunur/?$ /ygu-hakkinda/ygu-olma-sartlari/yangin-guvenlik-uzmani-nasil-olunur [R=301,L]
RewriteRule ^ygu-seviyeleri/?$ /ygu-hakkinda/ygu-olma-sartlari/ygu-seviyeleri [R=301,L]
RewriteRule ^ygu-egitim-sinav-belgelendirme/?$ /ygu-hakkinda/egitim-ve-belgelendirme/ygu-egitim-sinav-belgelendirme [R=301,L]
RewriteRule ^yangin-guvenlik-uzmani-gorevleri/?$ /ygu-hakkinda/merak-edilenler/yangin-guvenlik-uzmani-gorevleri [R=301,L]
RewriteRule ^ygu-hakkinda/merak-edilenler/calisma-alanlari/?$ /calisma-alanlari [R=301,L]
RewriteRule ^ygu-serbest-calisma/?$ /ygu-hakkinda/merak-edilenler/ygu-serbest-calisma [R=301,L]

# /ygu-hakkinda/ → /ygu-hakkinda
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /ygu-hakkinda → ygu-hakkinda/index.html (adres çubuğu değişmez)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ /$1/index.html [L]

# Önbellek: _nuxt/ dosya adları içerik özeti taşır, değişince adı da değişir → 1 yıl. Yazı tipleri de 1 yıl.
# HTML her seferinde sunucuya sorulsun (yeni yayın hemen görünsün).
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/(_nuxt|fonts)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
