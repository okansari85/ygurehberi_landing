# YGU Rehberi (statik Nuxt çıktısı, Apache/cPanel).
# Amaç: her sayfanın tek adresi olsun — https://ygurehberi.com/yol (www yok, http yok, sonda / yok).
# sitemap.xml ve canonical etiketleri bu biçimi kullanır; Search Console "yönlendirmeli sayfa" uyarısı vermesin.

Options -Indexes
DirectorySlash Off
ErrorDocument 404 /404.html

RewriteEngine On

# www → çıplak alan adı
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# http → https
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# /ygu-hakkinda/ → /ygu-hakkinda
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /ygu-hakkinda → ygu-hakkinda/index.html (adres çubuğu değişmez)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ /$1/index.html [L]
